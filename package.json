    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "pouchdb-adapter-idb": "^9.0.0",
    "pouchdb-core": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "pouchdb-mapreduce": "^9.0.0",
    "qrcode-generator": "1.4"
