<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>in.englishcompiler.tcsync.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@SERVER_DIR@/run-serve.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TAILCAT_BIN</key><string>@TAILCAT_BIN@</string>
    <key>TCSYNC_CONFIG</key><string>@TCSYNC_CONFIG@</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@TCSYNC_LOGS@/serve.log</string>
  <key>StandardErrorPath</key><string>@TCSYNC_LOGS@/serve.log</string>
</dict>
</plist>
